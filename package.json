{
  "name": "kite",
  "productName": "Kite",
  "version": "1.0.3",
  "description": "HWP/HWPX/DOCX/DOC/PDF/MD 문서 편집기",
  "author": "SMIC",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "node scripts/gen-notices.mjs && tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "node scripts/bump-version.mjs && npm run build && electron-builder --win",
    "dist:same": "npm run build && electron-builder --win",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "dist:store": "node scripts/bump-version.mjs && npm run build && electron-builder --win appx",
    "dist:msix": "node scripts/bump-version.mjs && npm run build && node scripts/pack-msix.mjs --build",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "build": {
    "appId": "kr.smic.kite",
    "productName": "Kite",
    "icon": "build/icon.ico",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "hwp",
        "name": "HWP 문서",
        "icon": "build/icon.ico"
      },
      {
        "ext": "hwpx",
        "name": "HWPX 문서",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Kite",
      "allowToChangeInstallationDirectory": true
    },
    "electronDist": "node_modules/electron/dist",
    "appx": {
      "identityName": "minary.KiteWord",
      "publisher": "CN=C460CD23-2642-4BA2-A332-6F8ADBE54E1F",
      "publisherDisplayName": "minary",
      "displayName": "Kite Writer",
      "applicationId": "Kite",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "backgroundColor": "#1F3A68",
      "capabilities": [
        "internetClient",
        "privateNetworkClientServer"
      ],
      "customManifestPath": "appx/appxmanifest.xml",
      "customExtensionsPath": "build/appx/extensions.xml"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@google/genai": "^2.30.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-character-count": "^2.27.3",
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-font-family": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-subscript": "^2.27.3",
    "@tiptap/extension-superscript": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/node": "^26.6.5",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cfb": "^1.2.2",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "openai": "^7.34.0",
    "pako": "^3.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "word-extractor": "^1.0.4"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "lib0": "^0.2.119",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  }
}
